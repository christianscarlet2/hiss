//*****************************************************************************
//  30_classify - made-hand / draw / board-texture classification.
//  Wraps the built-in Have* and board symbols into the concepts the two
//  strategies reason about.
//*****************************************************************************

//-----------------------------------------------------------------------------
//  Made-hand tiers
//-----------------------------------------------------------------------------

##f$HaveBigMade##
// Straight or better - the hands you commit with. [N "near-nuts"][B set+]
WHEN HaveStraight OR HaveFlush OR HaveFullHouse OR HaveQuads RETURN true FORCE
WHEN Others RETURN false FORCE

##f$HaveStrongMade##
// Two pair / set / big made, or a clean overpair-top-pair on a dry board.
WHEN HaveSet OR HaveTwoPair OR f$HaveBigMade RETURN true FORCE
WHEN (HaveOverPair OR HaveTopPair) AND NOT FlushPossible AND NOT StraightPossible RETURN true FORCE
WHEN Others RETURN false FORCE

##f$HaveOnePair##
// The classic trap class: one pair, however big. "Don't go broke with one pair." [N p.125]
WHEN HaveOverPair OR HaveTopPair RETURN true FORCE
WHEN Others RETURN false FORCE

##f$HaveDecentMade##
WHEN HaveOverPair OR HaveTopPair OR HaveTwoPair OR HaveSet OR f$HaveBigMade RETURN true FORCE
WHEN Others RETURN false FORCE

##f$HaveMarginalMade##
// Weak pair / second pair / bottom pair - showdown value, not betting value.
WHEN f$HaveDecentMade RETURN false FORCE
WHEN HavePair OR HaveBottomPair RETURN true FORCE
WHEN Others RETURN false FORCE

//-----------------------------------------------------------------------------
//  Draws
//-----------------------------------------------------------------------------

##f$HaveBigDraw##
// The draws Brunson plays FAST (semi-bluff / shove). [B D6.1-D6.2]
WHEN HaveNutFlushDraw OR HaveFlushDraw OR HaveOpenEndedStraightDraw RETURN true FORCE
WHEN Others RETURN false FORCE

##f$HaveComboDraw##
// Pair+draw or two draws - "two ways to win", get it in. [B D6.6]
WHEN f$HaveBigDraw AND (HavePair OR HaveInsideStraightDraw) RETURN true FORCE
WHEN HaveFlushDraw AND HaveOpenEndedStraightDraw RETURN true FORCE
WHEN Others RETURN false FORCE

##f$HaveWeakDraw##
WHEN HaveInsideStraightDraw OR HaveBackdoorFlushDraw RETURN true FORCE
WHEN Others RETURN false FORCE

##f$DrawIsCompromised##
// POT CONSERVATION (Emrald, hn 2783860493): a STRAIGHT draw stops being worth a semi-bluff the
// moment the board can already be a flush. Two of its eight outs complete that flush for someone
// else, and the straight it does make is still second best to one. 8s7c on 6d5dJd / Kh was
// classed f$HaveBigDraw and fired 84% of pot into a monotone board holding ~6 clean outs to a
// hand that loses anyway. Only straight draws rot this way: a flush draw on the same board is
// drawing to the nuts-ish hand that beats everybody, so it keeps its aggression.
WHEN HaveFlushDraw OR HaveNutFlushDraw RETURN false FORCE
WHEN (HaveOpenEndedStraightDraw OR HaveInsideStraightDraw) AND FlushPossible RETURN true FORCE
WHEN Others RETURN false FORCE

##f$HaveAnyDraw##
WHEN f$HaveBigDraw OR f$HaveWeakDraw RETURN true FORCE
WHEN Others RETURN false FORCE

//-----------------------------------------------------------------------------
//  Board texture
//-----------------------------------------------------------------------------

##f$BoardWet##
// Draw-heavy / coordinated: charge draws, slow down marginal hands.
WHEN FlushPossible OR StraightPossible OR FlushDrawPossible RETURN true FORCE
WHEN Others RETURN false FORCE

##f$BoardDry##
// Hit-or-miss board: your pair is likely still good; cheap to give a free card. [N p.63]
WHEN NOT FlushPossible AND NOT StraightPossible AND NOT FlushDrawPossible RETURN true FORCE
WHEN Others RETURN false FORCE

##f$ScaryBoard##
// Brunson "frightening flop": someone surely connected - don't bluff into it. [B R5.3]
WHEN FlushPossible OR StraightOnBoard OR MoreThanOneStraightPossibleOnFlop RETURN true FORCE
WHEN Others RETURN false FORCE

//-----------------------------------------------------------------------------
//  HIGH-CARD board texture for c-bet bluffs (Gordon's combinatoric read). The
//  existing wet/dry/scary symbols are DRAW-based and blind to the board's HIGH
//  card. A flat-caller's range is loaded with broadways: a K/A/Q-high DRY flop
//  MISSES that range (few of those cards remain) -> great bluff-c-bet card; a
//  J/T-high DRY flop HITS it hard -> do NOT bluff-c-bet. [GG "Continuation-Bets
//  for Bluffs", "Low/Paired/Monotone Boards", "Parched Boards"]
//  HighestRankOnFlop is the numeric top board rank (Queen=12, King=13, Ace=14).
//-----------------------------------------------------------------------------

##f$BoardHighCardFoldy##
// Dry board whose HIGH card is Q+ (>=12): few Q/K/A combos left in a caller's
// flat range, so an air c-bet picks it up. Boost/keep the bluff-c-bet here.
WHEN f$BoardDry AND HighestRankOnFlop >= 12 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$BoardHighCardSticky##
// Dry board topped by a Jack or Ten (HighestRankOnFlop 10 or 11): HITS a flat
// caller's broadway-heavy range - do NOT fire an air c-bet here. (Q+ excluded.)
// Defined as the dry-board residue of the other two textures: a dry flop is exactly
// one of Foldy (Q+), Parched (<=9, no ace), or Sticky (J/T-high) - so this wires
// f$BoardHighCardFoldy + f$BoardParched into the live c-bet path (50_flop) instead of
// duplicating the rank thresholds. Behaviour-identical to "HighestRankOnFlop 10-11".
WHEN f$BoardDry AND NOT f$BoardHighCardFoldy AND NOT f$BoardParched RETURN true FORCE
WHEN Others RETURN false FORCE

##f$BoardParched##
// Low, rainbow, disconnected "parched" flop (e.g. 7-4-2 / 9-6-3 / 8-5-4): top card
// 9 or below AND dry. Misses everyone - barrel the whole range relentlessly; only
// slow/fold when an Ace turns (handled on the turn via AcePresentOnTurn). [GG]
WHEN f$BoardDry AND HighestRankOnFlop <= 9 AND NOT AcePresentOnFlop RETURN true FORCE
WHEN Others RETURN false FORCE

//-----------------------------------------------------------------------------
//  Initiative
//-----------------------------------------------------------------------------

##f$WasPreflopRaiser##
WHEN BotRaisedBeforeFlop RETURN true FORCE
WHEN Others RETURN false FORCE
