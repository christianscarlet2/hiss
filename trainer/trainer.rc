    LTEXT           "Spacing px:",IDC_STATIC,205,85,44,8
    EDITTEXT        IDC_CHAR_SPACING,251,83,30,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_CHAR_SPACING_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,281,83,11,14
    CONTROL         "No preprocessing",IDC_NO_PREPROCESS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,127,90,10
    CONTROL         "Disable whitelist",IDC_NO_WHITELIST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,108,127,82,10
    CONTROL         "Use decimal splitting",IDC_USE_DECIMAL_SPLIT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,196,127,110,10
    CONTROL         "Decimal correction (re-insert dropped '.')",IDC_DECIMAL_CORRECT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,139,180,10

    GROUPBOX        "Scraped Region (OCR input \x96 hover to zoom 4x)",IDC_STATIC,7,150,346,58
    CONTROL         "",IDC_SCRAPE_PREVIEW,"Static",SS_BLACKFRAME,14,162,332,40

    GROUPBOX        "OCR Preview (selected region)",IDC_STATIC,7,212,346,86
    CONTROL         "",IDC_OCR_PREVIEW,"Static",SS_BLACKFRAME,14,226,210,42
    LTEXT           "Decimal trim %:",IDC_STATIC,14,274,58,8
    EDITTEXT        IDC_SPLIT_MARGIN,74,272,30,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPLIT_MARGIN_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,104,272,11,14
    LTEXT           "Split left:",IDC_STATIC,232,222,44,8
    EDITTEXT        IDC_SPLIT_LEFT,232,232,114,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Split right:",IDC_STATIC,232,248,44,8
    EDITTEXT        IDC_SPLIT_RIGHT,232,258,114,12,ES_AUTOHSCROLL | ES_READONLY
